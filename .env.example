# Resend (contact form email delivery)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: override which inbox receives contact form messages.
# Defaults to business.email in lib/business.ts if unset.
CONTACT_TO_EMAIL=

# EasyPractice booking page link.
# Defaults to https://system.easypractice.net/book/sikker-havn-ergoterapi if unset.
NEXT_PUBLIC_BOOKING_URL=https://system.easypractice.net/book/sikker-havn-ergoterapi
